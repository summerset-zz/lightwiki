<!doctype html>
<html lang="<%= it.lang %>">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= it.category.label %> · <%= it.site.title %></title>
<link rel="stylesheet" href="<%= it.site.base %>/assets/theme/style.css">
</head>
<body>
<div class="shell">
  <aside class="sidebar">
    <a class="brand" href="<%= it.index.url %>"><%= it.site.title %></a>
    <nav>
<% for (const group of it.nav) { %>
      <div class="nav-group">
        <% if (group.section) { %><p class="nav-section"><%= group.section %></p><% } %>
        <ul>
<% for (const item of group.pages) { %>
          <li><a href="<%= item.url %>"><%= item.title %></a></li>
<% } %>
        </ul>
      </div>
<% } %>
    </nav>
  </aside>

  <main class="content">
    <article>
      <h1><%= it.category.label %></h1>
      <p class="meta">分类 <code><%= it.category.slug %></code> · 共 <%= it.category.pages.length %> 篇</p>
      <ul class="index-list">
<% for (const item of it.category.pages) { %>
        <li><a href="<%= item.url %>"><%= item.title %></a></li>
<% } %>
      </ul>
    </article>
  </main>
</div>
</body>
</html>
