<!doctype html>
<html>
<head>
<meta charset="utf-8">
<meta http-equiv="refresh" content="0; url=<%= it.href %>">
<link rel="canonical" href="<%= it.canonical %>">
<meta name="robots" content="noindex">
<title>页面已移动</title>
<link rel="stylesheet" href="<%= it.site.base %>/assets/theme/style.css">
</head>
<body>
<main class="content" style="padding: 4rem 1.5rem; max-width: 40rem; margin: 0 auto">
  <h1>页面已移动</h1>
  <p>新地址：<a href="<%= it.href %>"><%= it.to %></a></p>
  <p class="meta">如果浏览器没有自动跳转，请点上面的链接。</p>
</main>
<script>
  location.replace(<%~ JSON.stringify(it.href) %> + location.hash + location.search);
</script>
</body>
</html>
