{
  "name": "lightwiki",
  "version": "0.1.1",
  "private": true,
  "description": "把 markdown + frontmatter 编译成一组可移植静态文件的知识库工具",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/summerset-zz/lightwiki.git"
  },
  "homepage": "https://summerset-zz.github.io/lightwiki/",
  "bugs": {
    "url": "https://github.com/summerset-zz/lightwiki/issues"
  },
  "type": "module",
  "packageManager": "yarn@4.9.2",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "type:check": "tsc -p tsconfig.json",
    "wiki": "tsx packages/cli/src/index.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "5.9.3"
  }
}
